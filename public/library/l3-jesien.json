  "phrases": [
    {
      "index": 0,
      "text": "Jesień w mieście ma swój własny, niepowtarzalny rytm.",
      "start": 0,
      "end": 3.913
    },
    {
      "index": 1,
      "text": "Poranki stają się chłodniejsze, a światło, które wpada między kamienice, nabiera złotawej barwy.",
      "start": 4.354,
      "end": 10.681
    },
    {
      "index": 2,
      "text": "Liście, początkowo zielone, powoli przybierają odcienie żółci, pomarańczy i czerwieni, by w końcu opaść na wilgotne chodniki.",
      "start": 11.122,
      "end": 20.201
    },
    {
      "index": 3,
      "text": "Ludzie idą szybciej niż latem, chowając dłonie w kieszeniach płaszczy.",
      "start": 20.526,
      "end": 24.671
    },
    {
      "index": 4,
      "text": "Z otwartych drzwi kawiarni unosi się zapach cynamonu i świeżo mielonej kawy.",
      "start": 25.054,
      "end": 30.116
    },
    {
      "index": 5,
      "text": "Mimo wczesnej pory ulice tętnią życiem: tramwaje suną wzdłuż torów, a gdzieś w oddali słychać dzwony kościoła.",
      "start": 30.499,
      "end": 39.462
    },
    {
      "index": 6,
      "text": "Dla wielu mieszkańców to właśnie ta pora roku, choć krótka i zmienna, kryje w sobie najwięcej spokoju i zadumy.",
      "start": 39.903,
      "end": 47.693
    }
  ]
}