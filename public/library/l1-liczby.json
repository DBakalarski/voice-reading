    {
      "index": 6,
      "text": "Tydzień ma siedem dni.",
      "start": 10.809,
      "end": 12.214
    },
    {
      "index": 7,
      "text": "Rok ma dwanaście miesięcy.",
      "start": 12.388,
      "end": 14.095
    },
    {
      "index": 8,
      "text": "Teraz jest godzina ósma.",
      "start": 14.245,
      "end": 15.894
    },
    {
      "index": 9,
      "text": "Mam dużo czasu.",
