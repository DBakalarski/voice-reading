  "phrases": [
    {
      "index": 0,
      "text": "Liczę powoli.",
      "start": 0,
      "end": 1.277
    },
    {
      "index": 1,
      "text": "Jeden, dwa, trzy.",
      "start": 1.451,
      "end": 3.704
    },
    {
      "index": 2,
      "text": "Cztery, pięć, sześć.",
      "start": 3.82,
      "end": 6.211
    },
    {
      "index": 3,
      "text": "To jest prosta liczba.",
      "start": 6.385,
      "end": 7.767
