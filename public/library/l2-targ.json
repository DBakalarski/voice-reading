  "phrases": [
    {
      "index": 0,
      "text": "W sobotę rano poszłam na targ niedaleko domu.",
      "start": 0,
      "end": 2.879
    },
    {
      "index": 1,
      "text": "Na straganach leżały świeże warzywa i owoce.",
      "start": 3.123,
      "end": 5.979
    },
    {
      "index": 2,
      "text": "Kupiłam kilogram jabłek, bochenek chleba i bukiet kwiatów.",
      "start": 6.153,
      "end": 9.857
    },
    {
      "index": 3,
      "text": "Sprzedawca uśmiechnął się i zapytał, jak mija mi dzień.",
      "start": 10.182,
      "end": 13.293
    },
    {
      "index": 4,
      "text": "Powiedziałam, że bardzo dobrze, bo pogoda była słoneczna.",
      "start": 13.444,
      "end": 16.823
    },
    {
      "index": 5,
      "text": "W drodze powrotnej spotkałam sąsiadkę, która niosła ciężką torbę.",
      "start": 17.067,
      "end": 20.864
    },
    {
      "index": 6,
      "text": "Pomogłam jej donieść zakupy do domu.",
      "start": 21.073,
      "end": 23.36
    },
    {
      "index": 7,
      "text": "Kiedy wróciłam, zaparzyłam kawę i usiadłam przy oknie.",
      "start": 23.476,
      "end": 26.947
    },
    {
      "index": 8,
      "text": "To był spokojny i miły poranek.",
      "start": 27.226,
      "end": 29.629
    }
  ]
}