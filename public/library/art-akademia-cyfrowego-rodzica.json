  "phrases": [
    {
      "index": 0,
      "text": "Internet przestał być dodatkiem do życia, ale stał się jego częścią.",
      "start": 0,
      "end": 4.481
    },
    {
      "index": 1,
      "text": "Fundacja Nauka.",
      "start": 5.05,
      "end": 6.362
    },
    {
      "index": 2,
      "text": "To Lubię prowadzi projekt Akademia Cyfrowego Rodzica, który przeprowadza rodziców przez cyfrowy świat, w którym poruszają się ich dzieci.",
      "start": 6.931,
      "end": 15.43
    },
    {
      "index": 3,
      "text": "Wirtualny świat jest rzeczywistością Wystarczyło kilkanaście lat, aby z ograniczonego dostępem medium, przerodził się w ogólnodostępne udogodnienie życia.",
      "start": 16.103,
      "end": 27.446
    },
    {
      "index": 4,
      "text": "Internet, bo o nim mowa, stał się naszym oknem na świat.",
      "start": 28.224,
      "end": 32.647
    },
    {
      "index": 5,
      "text": "Wystarczy sięgnąć do kieszeni, po smartfon, aby zyskać dostęp do najświeższych informacji czy zdjęć z dalekich zakątków świata.",
      "start": 33.321,
      "end": 42.864
    },
    {
      "index": 6,
      "text": "Uzyskać możliwość zakupów, które od realizacji dzieli tylko kilka kliknięć oraz szybkiego kontaktu z bliskimi.",
      "start": 43.642,
      "end": 51.456
    },
    {
      "index": 7,
      "text": "Cyfrowy świat to dzisiaj rzeczywistość, bez której trudno wyobrazić sobie codzienne funkcjonowanie.",
      "start": 51.944,
      "end": 58.643
    },
    {
      "index": 8,
      "text": "Na pierwszy rzut oka, ze wspomnianego okna rozpościera się wyłącznie atrakcyjny widok.",
      "start": 59.42,
      "end": 65.551
    },
    {
      "index": 9,
      "text": "Niestety, jeśli wytężymy wzrok, zobaczymy też ciemne zaułki.",
      "start": 66.328,
      "end": 71.031
    },
    {
      "index": 10,
      "text": "Cyfrowa rewolucja Z technologii korzystamy nie tylko my, ale także nasze dzieci, a dodatkowo czas pandemii pokazał, jak bardzo sfera cyfrowa jest nieodłącznym elementem codzienności.",
      "start": 71.599,
      "end": 85.032
    },
    {
      "index": 11,
      "text": "Trwa cyfrowa rewolucja, która ma coraz większy wpływ na życie rodziców i ich dzieci.",
      "start": 85.601,
      "end": 91.081
    },
    {
      "index": 12,
      "text": "Liczne badania pokazują, że rodzice rzadko kontrolują zachowania swoich dzieci w sieci i często nie mają świadomości, jakie zagrożenia ich dotykają.",
      "start": 91.986,
      "end": 101.855
    },
    {
      "index": 13,
      "text": "Jak się odnaleźć w zmieniającej się rzeczywistości, aby uniknąć zagrożeń i wykorzystać możliwości, jakie dają nowoczesne technologie?",
      "start": 102.633,
      "end": 111.956
    },
    {
      "index": 14,
      "text": "W tym właśnie wspiera Akademia Cyfrowego Rodzica.",
      "start": 112.316,
      "end": 115.52
    },
    {
      "index": 15,
      "text": "Czym jest Akademia Cyfrowego Rodzica?",
      "start": 116.008,
      "end": 118.376
    },
    {
      "index": 16,
      "text": "Fundacja Nauka.",
      "start": 118.864,
      "end": 120.176
    },
    {
      "index": 17,
      "text": "To Lubię prowadzi projekt Akademia Cyfrowego Rodzica, który przeprowadza rodziców przez cyfrowy świat, w którym poruszają się ich dzieci.",
      "start": 120.663,
      "end": 129.232
    },
    {
      "index": 18,
      "text": "W ramach Akademii z jednej strony uczulamy rodziców przed niebezpieczeństwami, jakie mogą spotkać ich dzieci w sieci, ale pokazujemy też dobre strony sfery technologii i oswajamy rodziców z tym tematem.",
      "start": 129.8,
      "end": 143.326
    },
    {
      "index": 19,
      "text": "W ramach Akademii Cyfrowego Rodzica tworzymy miejsce przyjazne dla rodziców i nauczycieli.",
      "start": 144.231,
      "end": 149.328
    },
    {
      "index": 20,
      "text": "Powstają wartościowe artykuły, filmy i webinary.",
      "start": 149.897,
      "end": 154.076
    },
    {
      "index": 21,
      "text": "Nie brakuje treści, które pomagają budować relacje z dziećmi, wprowadzić najmłodszych w cyfrowy świat, ale też ukazujących ciemne strony wirtualnego świata.",
      "start": 154.645,
      "end": 165.605
    },
    {
      "index": 22,
      "text": "W “strefie rodzica” publikujemy nie tylko poradniki, ale również wyniki badań naukowców z całego świata, dotyczące cyfrowej rzeczywistości i jej wpływu na dzieci.",
      "start": 166.383,
      "end": 178.004
    }
  ]
}