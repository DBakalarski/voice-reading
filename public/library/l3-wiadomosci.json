  "phrases": [
    {
      "index": 0,
      "text": "Dzień dobry, oto najważniejsze informacje tego poranka.",
      "start": 0,
      "end": 3.437
    },
    {
      "index": 1,
      "text": "Synoptycy zapowiadają, że w ciągu najbliższych dni temperatura wyraźnie spadnie, a na północy kraju mogą pojawić się pierwsze przymrozki.",
      "start": 3.68,
      "end": 12.353
    },
    {
      "index": 2,
      "text": "W stolicy rozpoczął się remont głównego mostu, dlatego kierowcy powinni liczyć się z utrudnieniami i wybierać trasy alternatywne.",
      "start": 12.736,
      "end": 21.188
    },
    {
      "index": 3,
      "text": "Naukowcy z miejscowego uniwersytetu opublikowali wyniki badań, które mogą pomóc w ochronie zagrożonych gatunków ptaków.",
      "start": 21.513,
      "end": 29.443
    },
    {
      "index": 4,
      "text": "W świecie kultury rozpoczął się doroczny festiwal filmowy, na który zjechali twórcy z kilkunastu krajów.",
      "start": 29.884,
      "end": 35.619
    },
    {
      "index": 5,
      "text": "Na zakończenie sport: nasza reprezentacja awansowała do finału, pokonując rywali różnicą dwóch punktów.",
      "start": 35.898,
      "end": 42.678
    },
    {
      "index": 6,
      "text": "To wszystko na teraz, do usłyszenia za godzinę.",
      "start": 42.794,
      "end": 45.79
    }
  ]
}