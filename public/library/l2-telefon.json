  "phrases": [
    {
      "index": 0,
      "text": "Wczoraj wieczorem zadzwoniła do mnie moja przyjaciółka Anna.",
      "start": 0,
      "end": 3.413
    },
    {
      "index": 1,
      "text": "Powiedziała, że w sobotę organizuje małe przyjęcie z okazji urodzin.",
      "start": 3.657,
      "end": 7.767
    },
    {
      "index": 2,
      "text": "Zapytała, czy mam ochotę przyjść i kogo jeszcze powinna zaprosić.",
      "start": 8.092,
      "end": 11.947
    },
    {
      "index": 3,
      "text": "Odpowiedziałam, że bardzo się cieszę i na pewno będę.",
      "start": 12.225,
      "end": 15.36
    },
    {
      "index": 4,
      "text": "Umówiłyśmy się, że przyniosę domowe ciasto i kilka napojów.",
      "start": 15.685,
      "end": 19.551
    },
    {
      "index": 5,
      "text": "Rozmawiałyśmy jeszcze przez chwilę o pracy i o pogodzie.",
      "start": 19.795,
      "end": 22.953
    },
    {
      "index": 6,
      "text": "Zanim się rozłączyłyśmy, podała mi dokładny adres i godzinę.",
      "start": 23.231,
      "end": 27.504
    },
    {
      "index": 7,
      "text": "Odłożyłam telefon w bardzo dobrym nastroju.",
      "start": 27.782,
      "end": 30.511
    }
  ]
}