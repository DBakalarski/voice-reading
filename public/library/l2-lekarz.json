  "phrases": [
    {
      "index": 0,
      "text": "W poniedziałek rano miałem wizytę u lekarza.",
      "start": 0,
      "end": 2.624
    },
    {
      "index": 1,
      "text": "Umówiłem się na godzinę dziewiątą, więc wyszedłem z domu wcześniej.",
      "start": 2.868,
      "end": 6.699
    },
    {
      "index": 2,
      "text": "W poczekalni siedziało kilka osób, które czekały na swoją kolej.",
      "start": 6.978,
      "end": 10.96
    },
    {
      "index": 3,
      "text": "Kiedy pielęgniarka wywołała moje nazwisko, wszedłem do gabinetu.",
      "start": 11.238,
      "end": 15.452
    },
    {
      "index": 4,
      "text": "Lekarz zapytał, jak się czuję i co mi dolega.",
      "start": 15.731,
      "end": 18.68
    },
    {
      "index": 5,
      "text": "Opowiedziałem mu, że od kilku dni boli mnie gardło.",
      "start": 18.924,
      "end": 22.221
    },
    {
      "index": 6,
      "text": "Zbadał mnie dokładnie i przepisał lekarstwo.",
      "start": 22.5,
      "end": 25.251
    },
    {
      "index": 7,
      "text": "Na koniec poradził, żebym dużo odpoczywał i pił ciepłe płyny.",
      "start": 25.495,
      "end": 29.094
    },
    {
      "index": 8,
      "text": "Podziękowałem i umówiłem się na kolejną wizytę.",
      "start": 29.268,
      "end": 32.368
    }
  ]
}