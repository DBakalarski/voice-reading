  ],
  "phrases": [
    {
      "index": 0,
      "text": "Inne szacunki mówią o 1341 lub 1482 Ukraińcach, którzy ocalili co najmniej 2527 Polaków.",
      "start": 0,
      "end": 9.404
    },
    {
      "index": 1,
      "text": "Liczba ta może wydawać się mała – tak jak mała może wydawać się liczba 7232 Polaków uhonorowanych tytułem „Sprawiedliwego wśród Narodów Świata” za ratowanie Żydów.Obie grupy podejmowały ogromne ryzyko, udzielając pomocy.",
      "start": 10.031,
      "end": 25.507
    },
    {
      "index": 2,
      "text": "Ryzyko śmierci nie tylko własnej, ale i całej swojej rodziny.",
      "start": 26.18,
      "end": 30.023
    },
    {
      "index": 3,
      "text": "Nie można więc takiego heroizmu wymagać i oczekiwać od wszystkich.",
      "start": 30.697,
      "end": 34.795
    },
    {
      "index": 4,
      "text": "A trzeba wiedzieć, że w odróżnieniu od Polaków – Ukraińcy nawet po wojnie nie mogli się przyznać, że kogoś ratowali.",
      "start": 35.468,
      "end": 42.713
    },
    {
      "index": 5,
      "text": "Występowali wszak przeciwko swoim rodakom.",
      "start": 43.491,
      "end": 46.092
    },
    {
      "index": 6,
      "text": "W oczach nacjonalistów i swoich sąsiadów stawali się „zdrajcami”.",
      "start": 46.405,
      "end": 50.979
    },
    {
      "index": 7,
      "text": "Wielu przypłaciło to życiem, inni pozostali anonimowi na zawsze – nawet dla tych, których ocalili.Przeczytaj także: Ukraina chce dialogu z Polską.",
      "start": 51.548,
      "end": 63.088
    },
    {
      "index": 8,
      "text": "„Partnerskie, uczciwe i wzajemnie korzystne relacje”",
      "start": 63.576,
      "end": 68.127
    }
  ]
}